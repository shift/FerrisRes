  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# FerrisRes \u2014 T4 / Vulkan probe\n",
    "\n",
    "**This kernel exists to answer one question:** does wgpu see a hardware T4 on\n",
    "Kaggle, and how fast is the GPU trainer when it does?\n",
    "\n",
    "It is deliberately small. It does not train a real model, does not touch a\n",
    "corpus, and does not upload anything.\n",
    "\n",
    "Stops (does not fall back to CPU) if `nvidia-smi` is absent, no T4 is listed, or\n",
    "`ferrisres devices --json` reports only a software adapter.\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import json, shutil, subprocess\n",
    "from pathlib import Path\n",
    "\n",
    "def run(cmd, **kw):\n",
    "    return subprocess.run(cmd, capture_output=True, text=True, **kw)\n",
    "\n",
    "smi = shutil.which('nvidia-smi')\n",
    "if not smi:\n",
    "    raise SystemExit('no nvidia-smi: this is a CPU session. Settings -> Accelerator -> GPU T4 x2, Internet on, Restart Session.')\n",
    "\n",
    "print(run([smi, '-L']).stdout)\n",
    "gpu = run([smi, '--query-gpu=name,memory.total,driver_version', '--format=csv']).stdout\n",
    "print(gpu)\n",
    "assert 'T4' in gpu, 'nvidia-smi sees no T4; stop'\n",
    "\n",
    "# Vulkan loader state: the one thing that can make wgpu miss the GPU.\n",
    "print('--- libvulkan ---')\n",
    "print(run(['bash', '-lc', 'ldconfig -p | grep -i vulkan || echo none']).stdout)\n",
    "print('--- ICD manifests ---')\n",
    "print(run(['bash', '-lc', 'ls -l /usr/share/vulkan/icd.d/ 2>/dev/null || echo none']).stdout)\n",
    "print(run(['bash', '-lc', 'cat /usr/share/vulkan/icd.d/nvidia_icd.json 2>/dev/null || echo no-nvidia-icd']).stdout)\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "DEB = sorted(Path('/kaggle/input').glob('*/ferrisres_*_amd64.deb'))\n",
    "assert DEB, 'attach the ferrisres .deb dataset (dataset_sources)'\n",
    "print('deb:', DEB[-1])\n",
    "print(run(['dpkg', '-i', str(DEB[-1])]).stdout[-1500:])\n",
    "print(run(['bash', '-lc', 'ferrisres --version']).stdout)\n",
    "\n",
    "BIN = run(['bash', '-lc', 'command -v ferrisres']).stdout.strip()\n",
    "assert BIN, 'ferrisres not on PATH'\n",
    "\n",
    "probe = run([BIN, 'devices', '--json'])\n",
    "print('devices exit', probe.returncode)\n",
    "print(probe.stdout[-3000:])\n",
    "print(probe.stderr[-1000:])\n",
    "devices = json.loads(probe.stdout) if probe.returncode == 0 else []\n",
    "adapters = devices.get('adapters', devices) if isinstance(devices, dict) else devices\n",
    "hw = [a for a in adapters if not a.get('software', False) and a.get('kind') != 'Cpu']\n",
    "print('hardware adapters:', [(a['index'], a['name'], a['kind'], a['backend']) for a in hw])\n",
    "if not hw:\n",
    "    raise SystemExit('wgpu enumerates no hardware adapter. Check the Vulkan ICD above; do not fall back to CPU.')\n",
    "t4 = [a for a in hw if 'T4' in a.get('name', '')]\n",
    "assert t4, 'a hardware adapter exists but it is not a T4: ' + repr([a['name'] for a in hw])\n",
    "WGPU_ADAPTER = str(t4[0]['index'])\n",
    "import os\n",
    "os.environ['WGPU_ADAPTER_INDEX'] = WGPU_ADAPTER\n",
    "os.environ['WGPU_BACKEND'] = 'vulkan'\n",
    "print('selected adapter', WGPU_ADAPTER, t4[0]['name'])\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import os, re, time\n",
    "from pathlib import Path\n",
    "\n",
    "corpus = Path('/kaggle/working/probe.txt')\n",
    "words = 'the quick brown fox jumps over the lazy dog'.split()\n",
    "lines = []\n",
    "for i in range(100):\n",
    "    lines.append(' '.join(words[(i + k) % len(words)] for k in range(len(words))))\n",
    "    lines.append('the answer is %d .' % (i % 4))\n",
    "corpus.write_text('\\n'.join(lines) + '\\n')\n",
    "\n",
    "STEPS = 30\n",
    "OUT = Path('/kaggle/working/probe.ckpt')\n",
    "cmd = [BIN, 'train', '--data', str(corpus), '--data-format', 'text', '--chat-template', 'gemma',\n",
    "       '--hidden-dim', '64', '--num-blocks', '2', '--block-size', '4',\n",
    "       '--epochs', '1', '--batch-size', '4', '--learning-rate', '3e-3',\n",
    "       '--seq-len', '128', '--vocab', '259', '--seed', '42',\n",
    "       '--checkpoint-every', '1000', '--output', str(OUT), '--log-every', '5',\n",
    "       '--device', 'gpu']\n",
    "\n",
    "t0 = time.perf_counter()\n",
    "proc = subprocess.run(cmd, capture_output=True, text=True, env={**os.environ})\n",
    "elapsed = time.perf_counter() - t0\n",
    "log = proc.stdout + proc.stderr\n",
    "print(log[-5000:])\n",
    "assert proc.returncode == 0, f'train --device gpu failed ({proc.returncode})'\n",
    "\n",
    "m = re.search(r'steps=(\\d+).*initial_loss=([0-9.]+) final_loss=([0-9.]+)', log)\n",
    "assert m, 'no training summary'\n",
    "steps = int(m.group(1))\n",
    "tokens = steps * 4 * 128\n",
    "summary = {\n",
    "    'adapter_index': WGPU_ADAPTER,\n",
    "    'adapter_name': t4[0]['name'],\n",
    "    'steps': steps,\n",
    "    'seconds': round(elapsed, 2),\n",
    "    'tokens_per_s': round(tokens / elapsed, 1),\n",
    "    'initial_loss': float(m.group(2)),\n",
    "    'final_loss': float(m.group(3)),\n",
    "    'checkpoint': str(OUT),\n",
    "    'checkpoint_bytes': OUT.stat().st_size if OUT.exists() else None,\n",
    "}\n",
    "Path('/kaggle/working/probe.json').write_text(json.dumps(summary, indent=2))\n",
    "print(json.dumps(summary, indent=2))\n",
    "assert summary['final_loss'] < summary['initial_loss'], 'loss did not fall: the GPU path ran but did not learn'\n"
   ]
  }
 ],
